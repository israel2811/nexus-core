# Copy to /etc/nexus-offload.conf and chmod 600.
NEXUS_WINDOWS_HOST=<WINDOWS_LAN_IP>
NEXUS_WINDOWS_USER=<WINDOWS_SSH_USER>
NEXUS_WINDOWS_PROFILE=<WINDOWS_PROFILE_DIRECTORY_NAME>
NEXUS_WINDOWS_EXPECTED_HOST=<WINDOWS_HOSTNAME>
NEXUS_WINDOWS_KEY=<ABSOLUTE_PATH_TO_LINUX_TO_WINDOWS_SSH_KEY>
NEXUS_WINDOWS_HOME=/mnt/windows-home
NEXUS_BROKER_BIND=127.0.0.1
NEXUS_BROKER_PORT=8765
